hostname TAC-SW1
no ip domain lookup
ip domain name hphs.lab
service timestamps debug datetime msec
service timestamps log datetime msec
no ip http server
no ip http secure-server
username labadmin privilege 15 secret cisco1
enable secret cisco1
banner login ^HPHS authorized lab access only. Activity is monitored. Follow the acceptable use policy.^
ip ssh version 2
logging buffered 16384 informational
line con 0
 login local
 logging synchronous
 exec-timeout 30 0
line vty 0 4
 login local
 transport input ssh
 access-class SSH-ADMIN in
 exec-timeout 15 0
!
no ip routing
ip default-gateway 10.10.99.1
ip access-list standard SSH-ADMIN
 permit 10.10.99.0 0.0.0.255
 permit 10.20.99.0 0.0.0.255
 deny any log
spanning-tree mode rapid-pvst
spanning-tree vlan 10,20,40,99 priority 4096
!
vlan 10
 name CLINICAL
!
vlan 20
 name ADMINISTRATIVE
!
vlan 40
 name GUEST
!
vlan 99
 name MANAGEMENT
!
interface Vlan99
 ip address 10.10.99.11 255.255.255.0
 no shutdown
!
interface Ethernet0/0
 description TAC-FW1 G0/1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,40,99
 switchport nonegotiate
 no shutdown
!
interface Ethernet7/2
 description TAC-SW2 E7/2 primary
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,40,99
 switchport nonegotiate
 no shutdown
!
interface Ethernet7/3
 description TAC-SW2 E7/3 alternate
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,40,99
 switchport nonegotiate
 no shutdown
!
interface Ethernet1/1
 description TAC-CLINIC1
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
interface Ethernet1/2
 description TAC-ADMIN1
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
interface Ethernet2/0
 description TAC-Services
 switchport mode access
 switchport access vlan 99
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
logging source-interface Vlan99
logging host 10.10.99.10
logging trap informational
ntp source Vlan99
ntp server 10.10.99.10 prefer
!
interface Ethernet0/1
 shutdown
!
interface Ethernet0/2
 shutdown
!
interface Ethernet0/3
 shutdown
!
interface Ethernet1/0
 shutdown
!
interface Ethernet1/3
 shutdown
!
interface Ethernet2/1
 shutdown
!
interface Ethernet2/2
 shutdown
!
interface Ethernet2/3
 shutdown
!
interface Ethernet3/0
 shutdown
!
interface Ethernet3/1
 shutdown
!
interface Ethernet3/2
 shutdown
!
interface Ethernet3/3
 shutdown
!
interface Ethernet4/0
 shutdown
!
interface Ethernet4/1
 shutdown
!
interface Ethernet4/2
 shutdown
!
interface Ethernet4/3
 shutdown
!
interface Ethernet5/0
 shutdown
!
interface Ethernet5/1
 shutdown
!
interface Ethernet5/2
 shutdown
!
interface Ethernet5/3
 shutdown
!
interface Ethernet6/0
 shutdown
!
interface Ethernet6/1
 shutdown
!
interface Ethernet6/2
 shutdown
!
interface Ethernet6/3
 shutdown
!
interface Ethernet7/0
 shutdown
!
interface Ethernet7/1
 shutdown
!
end